# ---- Core ----
NODE_ENV=development
APP_VERSION=0.1.0
# Long random string used to sign device/client JWTs (openssl rand -hex 32)
AUTH_JWT_SECRET=change-me
# Admin key for /admin/* and admin token minting (openssl rand -hex 32)
ADMIN_API_KEY=change-me-admin
# Comma-separated access keys handed to the iOS app and the web app (each mints device/client tokens)
CLIENT_ACCESS_KEYS=change-me-client
# Key used by the merge worker (Cloud Run job) to claim/complete jobs
WORKER_API_KEY=change-me-worker
# Vercel sets this automatically for cron invocations when the env var exists
CRON_SECRET=change-me-cron
# Allowed browser origins for CORS (comma separated). *.vercel.app previews are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,https://ghostmap.vercel.app

# ---- Neon Postgres ----
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/ghostmap?sslmode=require

# ---- Google Cloud ----
GCP_PROJECT_ID=my-project
GCS_BUCKET=ghostmap-maps
# base64 of the service-account JSON key: base64 -i sa-key.json | tr -d '\n'
GCP_SA_KEY_B64=
# Optional: BigQuery billing export table for /admin/costs, e.g. my-project.billing.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
BILLING_EXPORT_TABLE=
# Optional: Cloud Run merge job (projects/<p>/locations/<region>/jobs/<name>)
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_MERGE_JOB=

# ---- Ably realtime ----
ABLY_API_KEY=appId.keyId:secret

# ---- New Relic ----
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ACCOUNT_ID=
# US or EU
NEW_RELIC_REGION=US
